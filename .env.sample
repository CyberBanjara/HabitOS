APP_API_BASE_URL=http://localhost:3000/api
APP_TEMPLATE_SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_TEMPLATE_ID/edit?usp=sharing

# Client Firebase config must be valid JSON on one line.
APP_FIREBASE_CONFIG={"apiKey":"YOUR_API_KEY","authDomain":"YOUR_PROJECT.firebaseapp.com","projectId":"YOUR_PROJECT","storageBucket":"YOUR_PROJECT.appspot.com","messagingSenderId":"YOUR_SENDER_ID","appId":"YOUR_APP_ID"}

RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

FIREBASE_PROJECT_ID=YOUR_PROJECT
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
